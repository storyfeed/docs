#!/usr/bin/env bash
# Prepares a fresh checkout for a cloud agent (an Amp orb is Debian 13): Node 24, `npm ci` and a storyfeed/ui checkout
# beside this one, enough for `npm run build`.
# No PHP: the build's drift guard and payload regeneration against core run only when STORYFEED_CORE points at a core checkout
# (as check-docs.yml does), which needs PHP and Composer there; they are skipped without it.
# Safe to run again.
set -euo pipefail

set -euo pipefail

# House rule: no AI attribution in commits. Installed first, before anything that can fail (a package mirror, a PPA), so a
# failed setup never leaves an agent committing without it. A repo-local commit-msg hook strips the trailers agents add (Amp-Thread-ID,
# Co-authored-by Amp/Claude/Anthropic, Claude-Session, "Generated with <AI tool>") and keeps human co-authors.
# Squash-merging stays the backstop. Repo-local only: never write into a global core.hooksPath (it may be the machine's
# own hooks). A commit-msg hook the repo already had is kept as commit-msg.local and still runs first.
# A core.hooksPath the repo already set is used only when it resolves inside this checkout (or its git dir);
# anything outside (a shared or machine-wide hooks folder) is left alone and $GIT_DIR/hooks is used instead.
TOP="$(git rev-parse --show-toplevel)"; GIT_DIR_ABS="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"  # shared by every worktree
HOOKS_DIR="$(git config --local --get core.hooksPath || true)"
case "$HOOKS_DIR" in ''|/*) ;; *) HOOKS_DIR="$TOP/$HOOKS_DIR" ;; esac
# Resolve without creating anything: realpath the nearest existing directory, then re-append the missing parts.
# A missing `.` or `..` part fails closed (an empty result counts as outside).
resolve() {
    local path="$1" rest=""
    while [ ! -d "$path" ]; do
        # Anything in the way that is not a directory (a file, a dangling or file symlink) fails closed too.
        { [ -e "$path" ] || [ -L "$path" ]; } && return 0
        case "${path##*/}" in . | ..) return 0 ;; esac
        rest="/${path##*/}$rest"; path="${path%/*}"; [ -n "$path" ] || path="/"
    done
    printf '%s%s\n' "$(cd "$path" && pwd -P)" "$rest"
}
[ -n "$HOOKS_DIR" ] && HOOKS_DIR="$(resolve "$HOOKS_DIR")"
case "$HOOKS_DIR" in
    "$(cd "$TOP" && pwd -P)"|"$(cd "$TOP" && pwd -P)"/*|"$(cd "$GIT_DIR_ABS" && pwd -P)"|"$(cd "$GIT_DIR_ABS" && pwd -P)"/*) ;;
    *) HOOKS_DIR="$GIT_DIR_ABS/hooks" ;;
esac
mkdir -p "$HOOKS_DIR"
git config --local core.hooksPath "$HOOKS_DIR"
if [ -f "$HOOKS_DIR/commit-msg" ] && ! grep -q 'Installed by .agents/setup' "$HOOKS_DIR/commit-msg"; then
    if [ -e "$HOOKS_DIR/commit-msg.local" ]; then
        echo "setup: $HOOKS_DIR has both commit-msg and commit-msg.local; chain them by hand, then rerun." >&2
        exit 1
    fi
    mv "$HOOKS_DIR/commit-msg" "$HOOKS_DIR/commit-msg.local"
fi
cat > "$HOOKS_DIR/commit-msg" <<'HOOK'
#!/bin/sh
# Installed by .agents/setup: strip AI attribution trailers, keep human co-authors. Portable (POSIX awk).
set -e
local_hook="$(dirname "$0")/commit-msg.local"
[ -x "$local_hook" ] && "$local_hook" "$@"
tmp="$(mktemp "$(dirname "$1")/commit-msg.strip.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
awk '{
    l = tolower($0)
    if (l ~ /^amp-thread(-id)?:/) next
    if (l ~ /^claude-session:/) next
    # Co-authors: only known bot identities (by address domain or exact bot name); human co-authors are kept.
    if (l ~ /^co-authored-by:/ && l ~ /@(ampcode\.com|anthropic\.com|openai\.com)>/) next
    if (l ~ /^co-authored-by:[ \t]*(amp|claude|claude code|copilot|github copilot|codex)[ \t]*</) next
    if (l ~ /(generated|created) (with|by) / && l ~ /(claude|ampcode|(^|[^a-z])amp([^a-z]|$)|codex|openai|chatgpt|copilot|gemini|cursor|(^|[^a-z])ai([^a-z]|$))/) next
    if (l ~ /claude\.ai\/code\/session/) next
    print
}' "$1" > "$tmp" && mv "$tmp" "$1"
HOOK
chmod +x "$HOOKS_DIR/commit-msg"
# End of the House rule block.
# Node 24 exactly, with npm present.
# When an image's own node comes first on PATH (an Amp orb's /usr/local/bin), Node 24 is pinned in later shells too: NODE_PIN_DIR holds
# node, npm and npx links to nodesource's /usr/bin ones (all three required), and one marked line, added once, puts it first in ~/.profile,
# ~/.bashrc and whichever of ~/.bash_profile and ~/.bash_login exists (a Bash login shell reads those instead of ~/.profile).
# Only those three names move ahead; the image's other /usr/local tools keep their place. NODE_SYSTEM_BIN and NODE_PIN_DIR exist for
# tests; a real run leaves them unset.
NODE_PIN_DIR="${NODE_PIN_DIR:-$HOME/.local/share/storyfeed-node24/bin}"
NODE_PIN_MARK='# storyfeed .agents/setup: Node 24 first'
[ -x "$NODE_PIN_DIR/node" ] && export PATH="$NODE_PIN_DIR:$PATH"
pin_node() {
    mkdir -p "$NODE_PIN_DIR"
    local tool
    for tool in node npm npx; do
        ln -sfn "$1/$tool" "$NODE_PIN_DIR/$tool"
    done
    local rc line="case \":\$PATH:\" in *\":$NODE_PIN_DIR:\"*) ;; *) export PATH=\"$NODE_PIN_DIR:\$PATH\" ;; esac $NODE_PIN_MARK"
    for rc in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.bash_login"; do
        case "$rc" in *bash_profile | *bash_login) [ -f "$rc" ] || continue ;; esac
        grep -qF "$NODE_PIN_MARK" "$rc" 2>/dev/null || printf '\n%s\n' "$line" >> "$rc"
    done
    export PATH="$NODE_PIN_DIR:$PATH"
    hash -r
}
node_ready() {
    command -v node >/dev/null && command -v npm >/dev/null && command -v npx >/dev/null || return 1
    node -e 'process.exit(Number(process.versions.node.split(".")[0]) === 24 ? 0 : 1)'
}
if ! node_ready; then
    curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
    sudo apt-get install -y nodejs
    # nodesource's node lands in /usr/bin; an image's own one earlier on PATH is shadowed by the pin, here and in later shells.
    hash -r
    system_bin="${NODE_SYSTEM_BIN:-/usr/bin}"
    if ! node_ready && [ -x "$system_bin/node" ] && [ -x "$system_bin/npm" ] && [ -x "$system_bin/npx" ]; then
        echo "setup: $(command -v node || echo 'no node') ($(node -v 2>/dev/null || echo none)) comes before $system_bin/node on PATH; pinning Node 24 first in $NODE_PIN_DIR (~/.profile, ~/.bashrc and any ~/.bash_profile or ~/.bash_login)." >&2
        pin_node "$system_bin"
    fi
    node_ready || { echo "setup: node is not Node 24 with npm and npx (found $(command -v node || echo none) $(node -v 2>/dev/null || echo))" >&2; exit 1; }
fi


npm ci
# The theme and the build's tests import the Vue kit from a storyfeed/ui checkout beside this one, as check-docs.yml checks it out.
# A public repository: cloned once, shallow, and left alone afterwards (pull it yourself to build against a newer kit).
[ -n "${STORYFEED_UI_PATH:-}" ] || [ -d ../storyfeed-ui/.git ] || git clone --depth 1 https://github.com/storyfeed/ui.git ../storyfeed-ui
