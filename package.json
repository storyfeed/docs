{
  "name": "storyfeed-docs",
  "private": true,
  "type": "module",
  "description": "Documentation site for storyfeed/storyfeed — docs.storyfeed.dev",
  "scripts": {
    "dev": "vitepress dev docs --port 5174",
    "build": "node --test scripts/cast.test.mjs scripts/code-memo.test.mjs scripts/world.test.mjs scripts/body-links.test.mjs scripts/schema.test.mjs && node scripts/drift-guard.mjs && node scripts/llms.mjs && vitepress build docs",
    "preview": "vitepress preview docs --port 5175",
    "drift": "node scripts/drift-detector/index.mjs",
    "test:drift": "node --test scripts/drift-detector/drift.test.mjs",
    "test:cast": "node --test scripts/cast.test.mjs",
    "llms": "node scripts/llms.mjs",
    "pdf": "node scripts/print-pdf.mjs",
    "pdf:spine": "node scripts/print-spine.mjs",
    "test:memo": "node --test scripts/code-memo.test.mjs",
    "test:world": "node --test scripts/world.test.mjs",
    "schema": "node scripts/schema.mjs",
    "payloads": "node scripts/payloads.mjs",
    "test:schema": "node --test scripts/schema.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "markdown-it-container": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "vitepress": "^2.0.0-alpha.19"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.2",
    "micromark": "^4.0.3",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "sanitize-html": "^2.17.7"
  }
}
