# macOS system files
.DS_Store

# Node.js dependencies
node_modules/

# VitePress build output and cache
docs/.vitepress/dist/
docs/.vitepress/cache/

# Editor-specific files
.vscode/
*.code-workspace

# Environment variables
.env.local
.env.*.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated at build time by scripts/llms.mjs — never committed, so it cannot go stale
docs/public/llms.txt
docs/public/llms-full.txt

# Lane briefs. They live under docs/ so a worker can read them beside the pages
# they describe, which also means VitePress would build each one into a public
# page — and a push to main here DEPLOYS. Ignored so `git add -A` cannot publish
# them, and excluded from the build below so a tracked one still would not.
docs/briefs/
